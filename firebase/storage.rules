rules_version = '2';

// ---------------------------------------------------------------------
// Stockpile — Firebase Storage Security Rules
//
// Layout:
//   /products/{uid}/{productId}   — product images, one per product
//   /logos/{uid}/logo             — a single business logo per account
//
// A signed-in user may only read/write files under their own UID
// folder. Uploads are capped at 5MB and must be image content types.
// ---------------------------------------------------------------------

service firebase.storage {
  match /b/{bucket}/o {

    match /products/{uid}/{productId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /logos/{uid}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
